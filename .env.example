# Copy to .env and fill in. .env is git-ignored — never commit real credentials.

# Example: database for SP4
# DATABASE_URL=sqlite:///data/interim/app.db

# Example: external data API keys
# SOLCAST_API_KEY=
# NREL_API_KEY=

# Example: local data root, if datasets live outside the repo
# EV_PROJECT_DATA_ROOT=D:\datasets\ev-charging
